{
  "name": "@devolunch/server",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --delay 500ms -e ts --exec tsx src/index.ts | pino-pretty",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts --max-warnings 0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@devolunch/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^0.7.0",
    "@google-cloud/storage": "^7.15.0",
    "ws": "^8.18.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "nodemon": "^3.1.10",
    "@types/compression": "1.8.1",
    "@types/cors": "^2.8.15",
    "@types/express": "^5.0.3",
    "pino-pretty": "^13.1.1",
    "@types/ws": "^8.5.12"
  }
}
