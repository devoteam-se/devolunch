{
  "name": "scraper-cloud-function",
  "version": "1.0.0",
  "description": "Google Cloud Function scraper",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "pnpm build && functions-framework --target=scrape --port=8081",
    "scrape": "pnpm build && node dist/scraper.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts --max-warnings 0",
    "format": "prettier --write .",
    "gcp-build": "node node_modules/puppeteer/install.js"
  },
  "author": "Jonas Stenberg",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/functions-framework": "3.2.0",
    "@google-cloud/storage": "^5.20.5",
    "@google-cloud/translate": "^6.3.1",
    "dotenv": "16.0.3",
    "openai": "^5.20.3",
    "pdf-parse": "1.1.1",
    "pdfjs-dist": "^4.7.76",
    "puppeteer": "^20.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@devolunch/shared": "workspace:^",
    "@pnpm/make-dedicated-lockfile": "^0.5.10"
  }
}
